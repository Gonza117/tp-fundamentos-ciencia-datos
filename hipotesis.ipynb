    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import scipy.stats as stats\n",
    "from scipy.stats import shapiro\n",
    "\n",
    "df_clean = pd.read_pickle(\"df_clean.pkl\")\n",
    "\n",
    "# 1. Filtrar por Argentina\n",
    "df_arg = df_clean[df_clean[\"Country\"] == \"Argentina\"].copy()\n",
    "\n",
    "\n",
    "# 3. Configurar y crear el gráfico\n",
    "plt.figure(figsize=(10, 6))\n",
    "sns.set_style(\"whitegrid\")\n",
    "\n",
    "# Graficar la distribución de los años de experiencia\n",
    "sns.histplot(data=df_arg, x=\"WorkExp\", bins=20, color=\"blue\", edgecolor=\"black\")\n",
    "\n",
    "# Configurar títulos y etiquetas\n",
    "plt.title(\"Distribución de Años de Experiencia (WorkExp) en Argentina\", fontsize=14, pad=15)\n",
    "plt.xlabel(\"Años de Experiencia Profesional\", fontsize=12)\n",
    "plt.ylabel(\"Cantidad de Desarrolladores\", fontsize=12)\n",
    "\n",
    "# Mostrar la leyenda para identificar las líneas\n",
    "plt.legend(fontsize=11)\n",
    "\n",
    "# Ajustar el diseño y mostrar\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "#Validacion de hipotesis\n",
    "\n",
    "# Grafico qqplot para analizar la normalidad de forma visual\n",
    "workexp = df_arg[\"WorkExp\"].dropna()\n",
    "\n",
    "plt.figure(figsize=(8, 5))\n",
    "stats.probplot(workexp, dist=\"norm\", plot=plt)\n",
    "\n",
    "plt.title(\"Gráfico Q-Q de WorkExp (Argentina)\", fontsize=14)\n",
    "plt.xlabel(\"Cuantiles Teóricos (Distribución Normal)\", fontsize=12)\n",
    "plt.ylabel(\"Valores Reales de WorkExp\", fontsize=12)\n",
    "plt.grid(True, linestyle=\"--\", alpha=0.7)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "#Analizamos normalidad con el test de Shapiro-wilk\n",
    "estadistico, p_valor = stats.shapiro(workexp)\n",
    "\n",
    "print(\"--- Test de Shapiro-Wilk ---\")\n",
    "print(f\"Estadístico: {estadistico}\")\n",
    "print(f\"Valor p: {p_valor}\")\n",
    "\n",
    "if p_valor > 0.05:\n",
    "    print(\"Conclusión: No se rechaza la normalidad\")\n",
    "else:\n",
    "    print(\"Conclusión: Se rechaza la normalidad (Los datos NO siguen una distribución normal).\")"
