    "import seaborn as sns\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.cluster import KMeans\n",
    "from sklearn.metrics import silhouette_score\n",
    "from sklearn.decomposition import PCA\n",
    "import scipy.stats as stats\n",
    "\n",
    "# 1. Carga de datos limpios\n",
    "df_clean = pd.read_pickle(\"df_clean.pkl\")\n",
    "cols_multivariada = [\"YearsCode\", \"WorkExp\", \"ToolCountWork\", \"ToolCountPersonal\"]\n",
    "\n",
    "# 2. Filtrado de nulos y estandarización\n",
    "df_cluster = df_clean[cols_multivariada].dropna().copy()\n",
    "scaler = StandardScaler()\n",
    "X_scaled = scaler.fit_transform(df_cluster[cols_multivariada])\n",
    "\n",
    "# 3. Evaluación de clusters (k = 2 a 6)\n",
    "k_range = range(2, 7)\n",
    "inercias, silhouettes = [], []\n",
    "\n",
    "for k in k_range:\n",
    "    kmeans_eval = KMeans(n_clusters=k, random_state=42, n_init=10)\n",
    "    labels_eval = kmeans_eval.fit_predict(X_scaled)\n",
    "    inercias.append(kmeans_eval.inertia_)\n",
    "    silhouettes.append(silhouette_score(X_scaled, labels_eval))\n",
    "\n",
    "# 4. Gráficos de diagnóstico (Codo y Silueta)\n",
    "fig, ax = plt.subplots(1, 2, figsize=(13, 5))\n",
    "sns.set_style(\"whitegrid\")\n",
    "\n",
    "ax[0].plot(k_range, inercias, marker='o', color='#1E88E5', linewidth=2)\n",
